# Copy to .env (git-ignored) and fill in. Compose reads it automatically.
#
# Only needed for `docker compose --profile api up`, i.e. running the API *in a container*. The
# default local loop — `docker compose up` for the infrastructure, `dotnet run --project apps/api`
# on the host — needs none of this: it authenticates to Foundry with your own `az login` and reads
# apps/api/appsettings.Development.json.

# --- Foundry chat deployment (ADR-0011) -------------------------------------
# Endpoint, deployment name and key: all three are on the deployment's page in the Foundry portal.
# The API refuses to start without endpoint and deployment.
FOUNDRY_ENDPOINT=
FOUNDRY_DEPLOYMENT=

# The key authenticates the container, which has no signed-in user whose identity it could borrow.
# It is a long-lived secret, so it belongs in a file git and Docker both ignore — this one, or
# appsettings.Development.json for host runs. Hosted in Azure the app will use a managed identity
# instead and this stays empty: the code falls back to DefaultAzureCredential when the key is blank.
FOUNDRY_API_KEY=

# --- Foundry image deployment (ADR-0010/0011) -------------------------------
# Needed by the generation worker (`docker compose --profile worker up`), which renders one image
# per page. This is a SECOND deployment on the same Foundry resource as FOUNDRY_DEPLOYMENT above:
# that one is a chat model, this one an image model. The name picks the route on its own: the four
# FLUX names (FLUX.2-pro, FLUX.2-flex, FLUX.1-Kontext-pro, FLUX-1.1-pro) are called through the
# Black Forest Labs provider route, anything else (gpt-image-1, gpt-image-1-mini, dall-e-3) through
# the Azure OpenAI images route. It reuses FOUNDRY_ENDPOINT and FOUNDRY_API_KEY.
FOUNDRY_IMAGE_DEPLOYMENT=

# --- Clerk ----------------------------------------------------
# only if you run API in the container (docker compose --profile api up).
CLERK_AUTHORITY=
CLERK_AUTHORIZED_PARTIES=

# --- Application Insights (ADR-0023) ----------------------------------------
# Optional. The connection string from the Application Insights resource's Overview page. Set, the
# API and the worker send requests, dependencies, exceptions and logs to it; blank, they send
# nothing. Host runs read the same variable from appsettings.Development.json or local.settings.json.
APPLICATIONINSIGHTS_CONNECTION_STRING=

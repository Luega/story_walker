{
  "version": "2.0",
  "telemetryMode": "OpenTelemetry",
  "logging": {
    "logLevel": {
      "default": "Information",
      "Host.Results": "Warning",
      "Host.Aggregator": "Warning"
    },
    "console": {
      "isEnabled": true
    }
  },
  "extensions": {
    "serviceBus": {
      "maxConcurrentCalls": 1,
      "maxAutoLockRenewalDuration": "00:35:00"
    }
  },
  "functionTimeout": "00:30:00"
}

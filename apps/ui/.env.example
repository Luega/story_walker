# Base URL of the StoryWalker API. Read only by the server-side proxy route at
# src/app/api/[...path]/route.ts — it never reaches the browser.
API_URL=http://localhost:5080

# --- Clerk (ADR-0002) -------------------------------------------------------
# Both keys come from the Clerk dashboard. The publishable key is public by design; the secret key
# is not — keep it in .env, which git ignores.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Where Clerk's components send people. These match the routes under src/app/.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# --- Application Insights (ADR-0023) ----------------------------------------
# Optional; blank sends nothing. The same connection string (the resource's Overview page) in both.
# Server side, read at startup by src/instrumentation.ts.
APPLICATIONINSIGHTS_CONNECTION_STRING=
# Browser side, read by src/instrumentation-client.ts. NEXT_PUBLIC_ means it is inlined into the
# client bundle at BUILD time - set it before `next build`, not only before `next start`. That is
# safe: it is an ingestion key, which can send telemetry but not read any.
NEXT_PUBLIC_APPLICATIONINSIGHTS_CONNECTION_STRING=
